{
  "mcpServers": {
    "shadcn-io": {
      "command": "npx",
      "args": ["tsx", "scripts/shadcn-io-catalog-mcp.ts"]
    },
    "twilio": {
      "command": "npx",
      "args": [
        "-y",
        "@twilio-alpha/mcp",
        "YOUR_ACCOUNT_SID/YOUR_API_KEY:YOUR_API_SECRET"
      ]
    },
    "user-twilio-telephony": {
      "command": "npx",
      "args": [
        "-y",
        "@twilio-alpha/mcp",
        "TWILIO_ACCOUNT_SID/TWILIO_API_KEY:TWILIO_API_SECRET",
        "--services",
        "twilio_api_v2010",
        "--tags",
        "Api20100401IncomingPhoneNumber"
      ]
    },
    "123checkme": {
      "url": "https://www.123checkme.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CHECKME_MCP_TOKEN}"
      }
    }
  }
}
