{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "kill-port 5173",
    "dev": "vite --host=0.0.0.0",
    "build:mcp-sandbox": "esbuild server/mcpSandbox/sandboxEntry.ts --bundle --format=iife --platform=browser --outfile=public/mcp-sandbox/sandbox.bundle.js",
    "mcp:sandbox": "tsx server/mcpSandboxServe.ts",
    "mcp:shell-pilot": "tsx server/mcpShellPilotServer.ts",
    "dev:web+mcp": "concurrently -k -n web,sbx,pilot -c blue,magenta,green \"npm run dev\" \"npm run mcp:sandbox\" \"npm run mcp:shell-pilot\"",
    "build": "npm run build:mcp-sandbox && vite build",
    "deploy:vps": "bash scripts/deploy.sh",
    "build:report": "vite build --mode analyze",
    "start": "tsx server/prodHost.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "shadcn-io:generate": "node scripts/generate-shadcn-io-component-index.mjs && node scripts/generate-shadcn-io-blocks-index.mjs && node scripts/sync-shadcn-io-catalog.mjs",
    "shadcn-io:health": "npx tsx scripts/check-shadcn-io-catalog-health.ts",
    "shadcn-io:refresh": "npm run shadcn-io:generate && npm run shadcn-io:health",
    "export-shell-menu-registry": "tsx scripts/export-shell-menu-registry.ts",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "import:rust-skills": "tsx scripts/import-rust-skills-registry.ts",
    "import:native-skills-cli": "tsx scripts/import-native-skills-cli-registry.ts",
    "import:skillshub": "tsx scripts/import-skillshub-registry.ts",
    "cursor:mcp:123checkme": "bash scripts/ensure-cursor-123checkme-mcp.sh",
    "check:dev-review": "py -3 scripts/dev_triangulation_check.py",
    "dev-review:ollama": "tsx scripts/uiReviewAgent.ts",
    "test:e2e": "playwright test",
    "test:shell-bootstrap": "tsx --test src/shell/shellBootstrap.test.ts",
    "verify:hardening": "npm run test:shell-bootstrap",
    "test": "tsx --test scripts/uiReviewRag.test.ts src/workspace/mailSearchRows.test.ts src/workspace/contactsMcpParse.test.ts src/workspace/workspaceIntentRouter.test.ts src/workspace/workspacePostConnect.test.ts src/workspace/driveListEmpty.test.ts src/workspace/callWorkspaceMcpAdapterCallsite.test.ts src/local-llm/threadSummaryV1.test.ts src/scope/scopeEngine.test.ts src/shell/shellStateCommands.test.ts src/shell/shellIntentRouter.test.ts src/shell/shellBootstrap.test.ts src/shell/shellAuthority.test.ts src/shell/shellNavigationApply.test.ts src/shell/workspaceState.test.ts src/core/shell/sessionEntryClassification.test.ts src/core/shell/shellPrimaryOutcome.test.ts src/core/compliance/spec009DisclosurePredicates.test.ts src/core/policy/localInterpretationRequired.test.ts src/core/coreImportBoundary.test.ts src/shellCanvas/deriveWorkspaceIntentForDisclosure.test.ts src/compliance/spec009PrimaryDisclosure.presentation.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mcp-ui/client": "^7.0.0",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "marked": "^15.0.0",
    "motion": "^12.23.24",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "~2.10.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "esbuild": "^0.28.0",
    "kill-port": "^2.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "zod": "^3.25.76"
  }
}
