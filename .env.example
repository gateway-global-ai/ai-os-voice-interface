# Copy to `.env.local` in this folder (gitignored). Vite loads env from this directory only.
#
# Google OAuth 2.0 Client ID (Web application) for in-app “Sign in with Google” (GIS) — Calendar/Gmail/Drive/Contacts read scopes.
# Cloud Console → Credentials → OAuth client → Authorized JavaScript origins: http://localhost:5173, production URL.
# VITE_GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# GEMINI_API_KEY — same-origin Gemini gateway (`/api/gemini/*`) for voice/chat. Required on the app host for `npm start`.
# Do not set VITE_GEMINI_API_KEY — Vite exposes every `VITE_*` variable to the browser; use GEMINI_API_KEY only.
# Do not use GOOGLE_API_KEY here; the gateway does not read it for Gemini.
#
# Production: do not leave `GEMINI_API_KEY=` empty in `.env.production` unless you rely on `.env.local` or
# process env — Vite load order used to erase `.env.local` keys; `server/mergeGeminiEnv.ts` backfills from `.env.local` when the merged key is empty.
#
# Google Cloud — API key restrictions: If the key is restricted to "Gemini API" and/or "Gemini for Google Cloud API",
# Google requires binding it to a service account. In the key editor, enable "Authenticate API calls through a
# service account" and pick the SA (for example `ai-os-127@…iam.gserviceaccount.com`); otherwise Save stays disabled
# or calls fail. The app still sends only `GEMINI_API_KEY` to `@google/genai` — binding is enforced on Google's side for that key.
GEMINI_API_KEY=

# Gemini TTS — Live (Bidi) vs one-shot only (same NDJSON contract on `/api/gemini/tts/stream`):
# - GEMINI_DISABLE_LIVE_TTS=1 — stream route uses the same path as POST /api/gemini/tts (no WebSocket).
# - GEMINI_USE_LIVE_TTS_STREAM=false — same as above (either knob is enough).
# - GEMINI_LIVE_TTS_TIMEOUT_MS — max wait for a Live session (default 60000; clamped 5000–120000).
# GEMINI_DISABLE_LIVE_TTS=1
# GEMINI_LIVE_TTS_TIMEOUT_MS=60000
#
# Live / Bidi model override (only when Live TTS is enabled): `GEMINI_LIVE_MODEL`, `GEMINI_MODEL_ID`, or
# `VITE_GEMINI_LIVE_MODEL` — see `resolveLiveTtsModel()` in `server/geminiServe.ts`. Default in code matches
# @google/genai docs: `gemini-live-2.5-flash-preview` (not old preview snapshots like `…native-audio-preview-12-2025`).
#
# Do not put a full `wss://generativelanguage.googleapis.com/...BidiGenerate…` URL in env for this app — the gateway
# does not read it; `@google/genai` builds the WebSocket URL from the SDK version / API surface. Hardcoding WSS in
# AI Studio or Cloud “secrets” can break when Google changes routing (e.g. v1beta → v1).

# OPENAI_API_KEY / DEEPSEEK_API_KEY — optional here; used by Menu → API health checks and by
# governing_docs Python scripts (peer review, lifecycle) when the same keys exist in .env.local.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# GitHub (HTTPS git + `gh` CLI) — a classic or fine-grained personal access token with at least `repo` for private work.
# Load into your shell: `source ./scripts/source-github-token.sh` (exports `GITHUB_TOKEN` and `GH_TOKEN` from `.env.local`).
# `gh` and Git (via `gh auth git-credential`) use these. If `gh auth status` says the token is invalid, create a
# new PAT in GitHub → Settings → Developer settings, then update `.env.local` only.
# GITHUB_TOKEN=

# Supabase Auth/Common project — browser clients MUST use the anon/publishable key so RLS policies are enforced.
# These common variables can point at the authentication project.
# VITE_SUPABASE_URL=https://your-auth-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# AI OS Supabase data project — shell menus, VCU rows, projects/tasks, and Stripe access mirrors.
# Only AI_OS_SUPABASE_URL and AI_OS_SUPABASE_PUBLIC_KEY are exposed to the browser by vite.config.ts.
# Never expose AI_OS_SUPABASE_SECRET_KEY or AI_OS_SUPABASE_DIRECT_CONNECTION_STRING in browser code.
# AI_OS_SUPABASE_URL=https://your-ai-os-project-ref.supabase.co
# AI_OS_SUPABASE_PUBLIC_KEY=sb_publishable_or_anon_key
# AI_OS_SUPABASE_DIRECT_CONNECTION_STRING=postgresql://...
# AI_OS_SUPABASE_SECRET_KEY=sb_secret_or_service_role_key

# VCU Stripe billing — server/Supabase Edge Function secrets only.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET through VITE_* variables.
# `vcu-create-checkout-session` reads STRIPE_SECRET_KEY and APP_URL, verifies the caller through
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY when those point at the auth project, and writes access state
# through AI_OS_SUPABASE_URL/AI_OS_SUPABASE_SECRET_KEY.
# `stripe-webhook` reads STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, AI_OS_SUPABASE_URL, and AI_OS_SUPABASE_SECRET_KEY.
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price lookup key seeded in `university_programs.stripe_price_lookup_key`: vcu_monthly

# OTP UI dev shortcut: when `VITE_OTP_SKIP_SEND=true`, the phone step still collects a number but skips the SMS call
# and jumps straight to the 6-digit OTP screen (see AuthPanel). Leave unset/false for normal send-OTP behavior.
# VITE_OTP_SKIP_SEND=true
#
# Dev proxy (vite.config.ts) + production (server/prodHost.ts) — 123checkme main API (server.js) vs optional AIOS Governance API:
# - VITE_OTP_PROXY_TARGET — where POST /api/send-otp and /api/verify-otp are forwarded (dev: Vite proxy; prod: prodHost fetch). Local default http://127.0.0.1:3010. Production example: https://www.123checkme.com
# - OTP_PROXY_TARGET — optional alias (server-only) if you avoid VITE_ prefix in systemd.
# - VITE_GOVERNANCE_PROXY_TARGET — catch‑all /api/* target (defaults to the same URL as OTP so send-magic-link etc. hit server.js).
# - VITE_GOVERNANCE_PROXY_REWRITE — set true to always rewrite /api → /v1 (Governance shape).
#   If unset, /api → /v1 runs only when governance target differs from OTP and looks like :8100 (local uvicorn).
# Governance REST API (optional: py …/governance_api.py on :8100) — start it before using Governance UI when pointed here.

# APP_URL — optional; used for self-referential links, OAuth callbacks.
APP_URL=http://www.gatewayglobal.ai

# Google Workspace MCP (AIOS-SPEC-007) — optional; external HTTP server for JSON-RPC tools/call.
# Put VITE_* here (in `.env.local`). Do NOT put the MCP host’s GOOGLE_OAUTH_* secrets in this app —
# those live only on the Workspace MCP server’s `.env` (see WORKSPACE.md / workspace-mcp-nginx-deploy.md).
#
# Programmable Search (`workspace.web.search` / MCP tool `search_custom`): GOOGLE_PSE_API_KEY and
# GOOGLE_PSE_ENGINE_ID are set on the MCP host only — not here. Enabling Custom Search API in GCP is not enough
# until the server process has those env vars and is restarted.
# If unset, control plane stays in not_configured for API calls.
#
# Production / CI (browser → public MCP host; MCP must allow CORS from your app origin):
# VITE_WORKSPACE_MCP_URL=https://mcp.gatewayglobal.ai/googleworkspace
#
# Local dev + CORS: the MCP host may not send Access-Control-Allow-Origin for http://localhost:5173.
# Copy this line into `.env.development.local` (gitignored) so only dev uses the proxy; keep the
# full https URL below in `.env.local` for `npm run build`:
#   VITE_WORKSPACE_MCP_URL=/__workspace_mcp
# (vite.config.ts proxies /__workspace_mcp → https://mcp.gatewayglobal.ai/googleworkspace.)
#
# VITE_WORKSPACE_MCP_URL=http://127.0.0.1:8787
#
# OAuth 2.1 MCP: Google access token (ya29…) on every MCP request — this app does not open a consent UI yet.
# Dev only: paste a short-lived token (never commit; rotate; do not use in production builds you ship to users):
# VITE_WORKSPACE_MCP_BEARER_TOKEN=ya29...
# Alias: VITE_GOOGLE_OAUTH_ACCESS_TOKEN=ya29...
#
# OAuth 2.1 MCP: do NOT send user_google_email in tool args (default). Bearer token identifies the user.
# Legacy single-user MCP that still requires user_google_email in arguments:
# VITE_WORKSPACE_MCP_INCLUDE_USER_EMAIL=true
# VITE_AIOS_GOOGLE_USER_EMAIL=you@gmail.com
# (Vite: shell env overrides .env for VITE_* — prefer VITE_AIOS_*; legacy VITE_WORKSPACE_GOOGLE_USER_EMAIL also read.)
#
# JSON-RPC POST path on that host (default /mcp). Optional:
# VITE_WORKSPACE_MCP_JSONRPC_PATH=/mcp
# Request timeout in ms (default 30000):
# VITE_WORKSPACE_MCP_TIMEOUT_MS=30000
#
# Dev proxy (vite.config.ts) — optional overrides:
# VITE_WORKSPACE_MCP_PROXY=false
# VITE_WORKSPACE_MCP_PROXY_TARGET=https://mcp.gatewayglobal.ai
#
# Gateway / Node API (not read by this Vite app — document for same-origin dispatch stacks):
# WORKSPACE_MCP_URL=https://mcp.gatewayglobal.ai/googleworkspace
# WORKSPACE_MCP_ADAPTER_MODE=external_mcp

# Local interpretation lane (Ollama) — read by Vite `loadEnv` (dev) and `server/prodHost.ts` (npm start after build).
# Same keys: GET /api/local-model/readiness, POST /api/local-model/chat
# PORT=5173
# NODE_ENV=production   (recommended for `npm start` so `loadEnv` picks `.env.production` when present)
# LOCAL_LLM_RUNTIME=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_REQUIRED_MODELS=llama3
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_FALLBACK=disabled
# (fallback: disabled | proposal | allowed — POL-MODEL-003 / OLLAMA_RUNTIME_STANDARD)

# Dev-only: hide the floating SPEC-010 scope metrics HUD (default: shown in `npm run dev`).
# VITE_SCOPE_METRICS_HUD=false
